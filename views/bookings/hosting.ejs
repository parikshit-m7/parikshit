<% layout("/layouts/boilerplate") %>
<section class="booking-page">
  <div class="section-kicker">Your guests</div>
  <h1 class="section-title">Host bookings</h1>
  <p class="section-subtitle">Paid bookings are confirmed automatically. Check guest details and payment progress here.</p>
  <% if (!bookings.length) { %>
    <div class="empty-state"><i class="fa-solid fa-calendar-check"></i><h3>No bookings yet</h3><p class="text-muted">Confirmed stays and active room holds will appear here.</p></div>
  <% } else { %>
    <div class="booking-list">
      <% for (const booking of bookings) { %>
        <article class="booking-card">
          <% if (booking.listing) { %><img src="<%= booking.listing.image?.url || 'https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&fit=crop&w=700&q=80' %>" alt="<%= booking.listing.title %>"><% } %>
          <div class="booking-card-body">
            <h2><%= booking.listing?.title || 'Stay no longer available' %></h2>
            <p class="text-muted"><%= booking.status === 'payment_pending' ? 'Guest checkout in progress · ' : 'Booked by ' %><%= booking.bookedBy?.username || 'Wanderlust guest' %></p>
            <div class="booking-facts"><span><strong>Check-in</strong><%= booking.checkIn.toLocaleDateString("en-IN", {timeZone:"UTC",day:"numeric",month:"short",year:"numeric"}) %></span><span><strong>Check-out</strong><%= booking.checkOut.toLocaleDateString("en-IN", {timeZone:"UTC",day:"numeric",month:"short",year:"numeric"}) %></span><span><strong>Rooms</strong><%= booking.rooms || 1 %></span><span><strong>Guests</strong><%= booking.guests %></span><span><strong>Total</strong>₹ <%= booking.totalPrice.toLocaleString("en-IN") %></span></div>
            <span class="booking-status status-<%= booking.status === 'payment_pending' ? 'pending' : booking.status %>"><%= booking.status === 'confirmed' ? 'Booked · deposit paid' : booking.status === 'payment_pending' ? 'Checkout in progress' : booking.status %></span>
            <% if (booking.status === 'confirmed') { %><p class="small mt-2 mb-0">Deposit received: ₹ <%= Number(booking.amountPaid || booking.depositAmount || 0).toLocaleString("en-IN") %> · Balance due at stay: ₹ <%= Math.max(0, booking.totalPrice - Number(booking.amountPaid || booking.depositAmount || 0)).toLocaleString("en-IN") %></p><% } else if (booking.status === 'payment_pending') { %><p class="small mt-2 mb-0">Deposit ₹ <%= booking.depositAmount.toLocaleString("en-IN") %> · hold ends <%= booking.holdExpiresAt?.toLocaleString("en-IN", {dateStyle:"medium",timeStyle:"short"}) %></p><% } %>
          </div>
          <% if (booking.listing) { %><a class="booking-open" href="/listings/<%= booking.listing._id %>" aria-label="View stay"><i class="fa-solid fa-arrow-up-right-from-square"></i></a><% } %>
        </article>
      <% } %>
    </div>
  <% } %>
</section>
