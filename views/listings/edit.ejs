<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-2">

    <h3>Edit your Listing</h3>

    <form method="POST"
          action="/listings/<%= listing._id %>?_method=PUT" novalidate
          class="needs-validation"
          enctype="multipart/form-data">
  

      <!-- Title -->
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>

        <input
          name="listing[title]"
          value="<%= listing.title %>"
          type="text"
          class="form-control"
          required
        />
         <div class="valid-feedback">
          Title looks good!
        </div>
      </div>


      <!-- Description -->
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>

        <textarea
          name="listing[description]"
          class="form-control"
          required
        ><%= listing.description %></textarea>
        <div class="invalid-feedback">
          Please enter a short description.
        </div>
      </div>


      <div class="mb-3">
        Original Listing Image <br>
        <img 
          src="<%= originalImageUrl %>"
          alt="Original listing"
          style="width: 200px; height: auto; object-fit: contain;"/>
      </div>
     
      <!-- Image -->
      <div class="mb-3">
        <label for="listing-photos" class="form-label">Add stay photos (minimum 5 total)</label>
        <input id="listing-photos" name="listing[images]" type="file" class="form-control listing-photo-input" accept="image/png,image/jpeg,image/jpg,image/webp" multiple data-existing-count="<%= listing.galleryIsSample ? 0 : (listing.image?.url ? 1 : 0) + (listing.gallery || []).length %>" data-sample-gallery="<%= listing.galleryIsSample ? 'true' : 'false' %>" />
        <div class="form-text" data-photo-count role="status"><%= listing.galleryIsSample ? 'This gallery has sample hotel photos. Upload at least 5 real photos to replace them.' : `Current photos: ${(listing.image?.url ? 1 : 0) + (listing.gallery || []).length}. Add photos of this same stay.` %></div>
      </div>


      <!-- Price + Country -->
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>

          <input
            name="listing[price]"
            value="<%= listing.price %>"
            type="number"
            class="form-control"
            required
          />

          <div class="invalid-feedback">
            Price should be valid.
          </div>
        </div>

        <div class="mb-3 col-md-4">
          <label for="rooms" class="form-label">Rooms available</label>
          <input id="rooms" name="listing[rooms]" type="number" class="form-control" min="1" max="99" value="<%= listing.rooms || 1 %>" required>
        </div>


        <div class="mb-3 col-md-4">
          <label for="country" class="form-label">Country</label>

          <input
            name="listing[country]"
            value="<%= listing.country %>"
            type="text"
            class="form-control"
            required
          />
           <div class="invalid-feedback">
            Country name should be valid.
          </div>
        </div>
        

      </div>


      <!-- Location -->
      <div class="mb-3">
        <label for="location" class="form-label">Location</label>

        <input
          id="location"
          name="listing[location]"
          value="<%= listing.location %>"
          list="popular-indian-locations"
          type="text"
          class="form-control"
          required
        />
        <datalist id="popular-indian-locations">
          <option value="Taj Mahal, Agra"></option>
          <option value="Varanasi, Uttar Pradesh"></option>
          <option value="Jaipur, Rajasthan"></option>
          <option value="Goa"></option>
          <option value="Delhi"></option>
          <option value="Kerala"></option>
          <option value="Udaipur, Rajasthan"></option>
          <option value="Manali, Himachal Pradesh"></option>
          <option value="Mumbai, Maharashtra"></option>
          <option value="Amritsar, Punjab"></option>
          <option value="Ayodhya, Uttar Pradesh"></option>
          <option value="Mysuru, Karnataka"></option>
        </datalist>
        <div class="invalid-feedback">
          Location should be valid.
        </div>
      </div>

      <div class="mb-3">
        <label for="contact-phone" class="form-label">Public contact number <span class="text-muted">(WhatsApp, calls, SMS)</span></label>
        <input id="contact-phone" name="listing[contactPhone]" value="<%= listing.contactPhone || '' %>" type="tel" class="form-control" placeholder="+91 98765 43210" autocomplete="tel">
      </div>

      <fieldset class="mb-3">
        <legend class="form-label">Stay categories</legend>
        <div class="d-flex flex-wrap gap-3">
          <label><input type="checkbox" name="listing[categories][]" value="slow-stays" <%= listing.categories?.includes("slow-stays") ? "checked" : "" %>> Slow stays</label>
          <label><input type="checkbox" name="listing[categories][]" value="city-breaks" <%= listing.categories?.includes("city-breaks") ? "checked" : "" %>> City breaks</label>
          <label><input type="checkbox" name="listing[categories][]" value="mountains" <%= listing.categories?.includes("mountains") ? "checked" : "" %>> Mountains</label>
          <label><input type="checkbox" name="listing[categories][]" value="by-water" <%= listing.categories?.includes("by-water") ? "checked" : "" %>> By the water</label>
          <label><input type="checkbox" name="listing[categories][]" value="outdoors" <%= listing.categories?.includes("outdoors") ? "checked" : "" %>> Outdoors</label>
          <label><input type="checkbox" name="listing[categories][]" value="hidden-gems" <%= listing.categories?.includes("hidden-gems") ? "checked" : "" %>> Hidden gems</label>
        </div>
      </fieldset>


      <!-- Button -->
      <button class="btn btn-dark edit-btn mt-3">
        Edit
      </button>

    </form>

  </div>
</div>
<script src="/js/listing-photo-count.js" defer></script>

