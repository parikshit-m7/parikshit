<% layout("/layouts/boilerplate") %>

<section class="hero-section">
  <div class="hero-copy">
    <div class="eyebrow">A little further. A lot more you.</div>
    <h1 class="hero-title">Your next story<br>starts <em>somewhere.</em></h1>
    <p class="hero-description">Thoughtful stays, unexpected places, and the kind of trips that stay with you long after you return.</p>
    <div class="hero-actions">
      <a class="hero-btn hero-btn-primary" href="#stays">Find your stay <i class="fa-solid fa-arrow-down"></i></a>
      <a class="hero-btn hero-btn-ghost" href="/listings/new"><i class="fa-solid fa-house"></i> Share your place</a>
    </div>
    <div class="hero-note">
      <span class="hero-note-mark"><i class="fa-solid fa-sparkles"></i></span>
      <span><strong>Made for curious people.</strong><br>Not just places to sleep.</span>
    </div>
  </div>
</section>


<section class="destination-section">
  <div class="section-heading">
    <div><div class="section-kicker">Explore India</div><h2 class="section-title">Where will you go next?</h2><p class="section-subtitle">Discover stays and local escapes across India.</p></div>
  </div>
  <div class="destination-grid">
    <a class="destination-tile" href="/listings?search=Agra"><span class="destination-icon"><i class="fa-solid fa-landmark"></i></span><span><strong>Agra</strong><small>India · Taj Mahal &amp; heritage</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Varanasi"><span class="destination-icon"><i class="fa-solid fa-place-of-worship"></i></span><span><strong>Varanasi</strong><small>India · Ghats &amp; culture</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Jaipur"><span class="destination-icon"><i class="fa-solid fa-landmark"></i></span><span><strong>Jaipur</strong><small>India · Heritage stays</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Goa"><span class="destination-icon"><i class="fa-solid fa-umbrella-beach"></i></span><span><strong>Goa</strong><small>India · Beach escapes</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Delhi"><span class="destination-icon"><i class="fa-solid fa-city"></i></span><span><strong>Delhi</strong><small>India · History &amp; city life</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Kerala"><span class="destination-icon"><i class="fa-solid fa-water"></i></span><span><strong>Kerala</strong><small>India · Backwaters</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Udaipur"><span class="destination-icon"><i class="fa-solid fa-water"></i></span><span><strong>Udaipur</strong><small>India · Lakeside stays</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Manali"><span class="destination-icon"><i class="fa-solid fa-mountain-sun"></i></span><span><strong>Manali</strong><small>India · Mountain air</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Mumbai"><span class="destination-icon"><i class="fa-solid fa-city"></i></span><span><strong>Mumbai</strong><small>India · City by the sea</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Amritsar"><span class="destination-icon"><i class="fa-solid fa-place-of-worship"></i></span><span><strong>Amritsar</strong><small>India · Golden Temple</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Ayodhya"><span class="destination-icon"><i class="fa-solid fa-place-of-worship"></i></span><span><strong>Ayodhya</strong><small>India · Sacred heritage</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Mysuru"><span class="destination-icon"><i class="fa-solid fa-landmark"></i></span><span><strong>Mysuru</strong><small>India · Palace &amp; culture</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
  </div>
</section>
<form class="price-filter" action="/listings" method="GET" id="stay-filters" data-search-active="<%= search ? 'true' : 'false' %>">
  <input type="hidden" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>">
  <input type="hidden" name="category" id="stay-category" value="<%= category || '' %>">
  <input type="hidden" name="lat" id="nearby-lat" value="<%= latitude %>">
  <input type="hidden" name="lng" id="nearby-lng" value="<%= longitude %>">
  <label for="nearby-radius">Nearby</label>
  <select id="nearby-radius" name="radius">
    <% for (const distance of [5, 10, 25, 50]) { %>
      <option value="<%= distance %>" <%= Number(radiusKm) === distance ? 'selected' : '' %>><%= distance %> km</option>
    <% } %>
  </select>
  <button type="button" id="nearby-search"><i class="fa-solid fa-location-crosshairs"></i> <%= nearby ? 'Update my location' : 'Find stays near me' %></button>
  <label for="minPrice">Min price ₹</label><input id="minPrice" type="number" name="minPrice" min="0" step="100" value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>" placeholder="Any">
  <label for="maxPrice">Max price ₹</label><input id="maxPrice" type="number" name="maxPrice" min="0" step="100" value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>" placeholder="Any">
  <button type="submit">Apply filters</button><a href="/listings#stays">Clear</a>
  <span id="nearby-message" class="nearby-message" role="status" aria-live="polite"></span>
</form>

<div class="section-heading" id="stays">
  <div>
    <div class="section-kicker">The collection</div>
    <h2 class="section-title"><%= nearby ? 'Stays near your location' : (typeof search !== 'undefined' && search ? 'Places matching your search' : 'Places worth the detour') %></h2>
    <p class="section-subtitle"><%= nearby ? `Showing stays within ${radiusKm} km, in order of distance.` : 'Find a place that feels like part of the adventure.' %></p>
  </div>
  <span class="section-count"><i class="fa-solid fa-compass me-1"></i> <%= allListings.length %> stays</span>
</div>

<div class="listing-grid destination-listing-grid" aria-label="Popular Indian stays">
  <% for (const destination of featuredDestinations) { const stay = destination.listing; %>
    <a class="listing-link" href="<%= stay ? `/listings/${stay._id}` : `/listings?search=${encodeURIComponent(destination.name)}` %>">
      <article class="card listing-card">
        <div class="listing-image-wrap">
          <img src="<%= stay?.image?.url || destination.image %>" class="card-img-top" alt="<%= stay ? stay.title : `${destination.name} destination` %>" loading="lazy">
          <span class="listing-badge"><i class="fa-solid fa-leaf me-1"></i> Worth discovering</span>
          <% if (stay) { %>
            <button class="listing-heart" type="button" data-favorite-id="<%= stay._id %>" aria-label="Save <%= stay.title %>" aria-pressed="false" title="Save this stay"><i class="fa-regular fa-heart" aria-hidden="true"></i></button>
          <% } %>
        </div>
        <div class="card-body">
          <div class="listing-title-row">
            <span class="listing-title"><%= stay ? stay.title : `${destination.name} stays` %></span>
            <span class="listing-rating"><i class="fa-solid fa-star"></i> <%= stay ? 'New' : 'Explore' %></span>
          </div>
          <p class="card-text"><i class="fa-solid fa-location-dot me-1"></i><%= stay ? stay.location : destination.name %><%= stay?.country ? ', ' + stay.country : ', India' %></p>
          <div class="listing-price"><%= stay ? `₹ ${stay.price ? stay.price.toLocaleString("en-IN") : "Price on request"}` : 'No stay listed yet' %> <span><%= stay ? '/ night' : '· Explore this place' %></span></div>
        </div>
      </article>
    </a>
  <% } %>
</div>

<% if (search) { %>
  <div id="filters" aria-label="Filter stays in <%= search %> by category">
    <button type="button" class="filter <%= category === 'trending' ? 'active' : '' %>" data-stay-category="trending" aria-pressed="<%= category === 'trending' %>"><i class="fa-solid fa-fire"></i><span>Trending</span></button>
    <button type="button" class="filter <%= category === 'slow-stays' ? 'active' : '' %>" data-stay-category="slow-stays" aria-pressed="<%= category === 'slow-stays' %>"><i class="fa-solid fa-bed"></i><span>Slow stays</span></button>
    <button type="button" class="filter <%= category === 'city-breaks' ? 'active' : '' %>" data-stay-category="city-breaks" aria-pressed="<%= category === 'city-breaks' %>"><i class="fa-solid fa-city"></i><span>City breaks</span></button>
    <button type="button" class="filter <%= category === 'mountains' ? 'active' : '' %>" data-stay-category="mountains" aria-pressed="<%= category === 'mountains' %>"><i class="fa-solid fa-mountain-sun"></i><span>Mountains</span></button>
    <button type="button" class="filter <%= category === 'by-water' ? 'active' : '' %>" data-stay-category="by-water" aria-pressed="<%= category === 'by-water' %>"><i class="fa-solid fa-water"></i><span>By the water</span></button>
    <button type="button" class="filter <%= category === 'outdoors' ? 'active' : '' %>" data-stay-category="outdoors" aria-pressed="<%= category === 'outdoors' %>"><i class="fa-solid fa-campground"></i><span>Outdoors</span></button>
    <button type="button" class="filter <%= category === 'hidden-gems' ? 'active' : '' %>" data-stay-category="hidden-gems" aria-pressed="<%= category === 'hidden-gems' %>"><i class="fa-solid fa-house-chimney-window"></i><span>Hidden gems</span></button>
  </div>
<% } %>

<% if (allListings.length) { %>
  <div class="listing-grid" id="listing-results">
    <% for (let listing of allListings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link" data-listing-id="<%= listing._id %>">
        <article class="card listing-card">
          <div class="listing-image-wrap">
            <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&fit=crop&w=900&q=80' %>"
              class="card-img-top" alt="<%= listing.title %>" loading="lazy">
            <span class="listing-badge"><i class="fa-solid fa-leaf me-1"></i> Worth discovering</span>
            <button class="listing-heart" type="button" data-favorite-id="<%= listing._id %>" aria-label="Save <%= listing.title %>" aria-pressed="false" title="Save this stay"><i class="fa-regular fa-heart" aria-hidden="true"></i></button>
          </div>
          <div class="card-body">
            <div class="listing-title-row">
              <span class="listing-title"><%= listing.title %></span>
              <span class="listing-rating"><i class="fa-solid fa-star"></i> New</span>
            </div>
            <p class="card-text"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location || 'A place to discover' %><%= listing.country ? ', ' + listing.country : '' %></p>
            <div class="listing-price">₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "Price on request" %> <span>/ night</span></div>
          </div>
        </article>
      </a>
    <% } %>
  </div>
<% } else { %>
  <div class="empty-state">
    <i class="fa-solid fa-binoculars"></i>
    <h3><%= nearby ? 'No stays found nearby' : 'No stays found just yet' %></h3>
    <p class="text-muted mb-4"><%= nearby ? 'Try a larger nearby radius or a wider price range.' : 'Try another destination or clear your search to see every place.' %></p>
    <a class="hero-btn hero-btn-primary" href="/listings">Explore all stays <i class="fa-solid fa-arrow-right"></i></a>
  </div>
<% } %>

<script>
  const nearbyButton = document.getElementById("nearby-search");
  nearbyButton?.addEventListener("click", () => {
    const message = document.getElementById("nearby-message");
    if (!navigator.geolocation) {
      message.textContent = "Location is not available in this browser.";
      return;
    }
    nearbyButton.disabled = true;
    message.textContent = "Getting your location…";
    navigator.geolocation.getCurrentPosition(({ coords }) => {
      document.getElementById("nearby-lat").value = coords.latitude;
      document.getElementById("nearby-lng").value = coords.longitude;
      document.getElementById("stay-filters").requestSubmit();
    }, (error) => {
      nearbyButton.disabled = false;
      message.textContent = error.code === error.PERMISSION_DENIED
        ? "Allow location access in your browser to find nearby stays."
        : "Could not get your location. Please try again.";
    }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 });
  });

  document.querySelectorAll("[data-stay-category]").forEach((button) => {
    button.addEventListener("click", () => {
      document.getElementById("stay-category").value = button.dataset.stayCategory;
      document.getElementById("stay-filters").requestSubmit();
    });
  });

  if (document.getElementById("stay-filters")?.dataset.searchActive === "true") {
    const firstSearchResult = document.querySelector("#listing-results .listing-link") || document.querySelector(".empty-state");
    firstSearchResult?.scrollIntoView({ behavior: "smooth", block: "center" });
  }

</script>
