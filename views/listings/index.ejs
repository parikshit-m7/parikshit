<% layout("/layouts/boilerplate") %>

<section class="hero-section">
  <div class="hero-copy">
    <div class="eyebrow">A little further. A lot more you.</div>
    <h1 class="hero-title">Your next story<br>starts <em>somewhere.</em></h1>
    <p class="hero-description">Thoughtful stays, unexpected places, and the kind of trips that stay with you long after you return.</p>
    <div class="hero-actions">
      <a class="hero-btn hero-btn-primary" href="#stays">Find your stay <i class="fa-solid fa-arrow-down"></i></a>
      <a class="hero-btn hero-btn-ghost" href="/listings/new"><i class="fa-solid fa-house"></i> Share your place</a>
    </div>
    <div class="hero-note">
      <span class="hero-note-mark"><i class="fa-solid fa-sparkles"></i></span>
      <span><strong>Made for curious people.</strong><br>Not just places to sleep.</span>
    </div>
  </div>
</section>


<section class="destination-section">
  <div class="section-heading">
    <div><div class="section-kicker">A world of possibilities</div><h2 class="section-title">Where will you go next?</h2><p class="section-subtitle">Choose a destination to search stays currently available in Wanderlust.</p></div>
  </div>
  <div class="destination-grid">
    <a class="destination-tile" href="/listings?search=Goa"><span class="destination-icon"><i class="fa-solid fa-umbrella-beach"></i></span><span><strong>Goa</strong><small>India · Beach escapes</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Manali"><span class="destination-icon"><i class="fa-solid fa-mountain-sun"></i></span><span><strong>Manali</strong><small>India · Mountain air</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Jaipur"><span class="destination-icon"><i class="fa-solid fa-landmark"></i></span><span><strong>Jaipur</strong><small>India · Heritage stays</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Kerala"><span class="destination-icon"><i class="fa-solid fa-water"></i></span><span><strong>Kerala</strong><small>India · Backwaters</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Dubai"><span class="destination-icon"><i class="fa-solid fa-city"></i></span><span><strong>Dubai</strong><small>UAE · City lights</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Bali"><span class="destination-icon"><i class="fa-solid fa-leaf"></i></span><span><strong>Bali</strong><small>Indonesia · Island calm</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=Paris"><span class="destination-icon"><i class="fa-solid fa-camera"></i></span><span><strong>Paris</strong><small>France · Culture & cafés</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
    <a class="destination-tile" href="/listings?search=London"><span class="destination-icon"><i class="fa-solid fa-compass"></i></span><span><strong>London</strong><small>UK · City adventures</small></span><i class="fa-solid fa-arrow-up-right-from-square destination-arrow"></i></a>
  </div>
</section>
\n<form class="price-filter" action="/listings" method="GET">
  <input type="hidden" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>">
  <label for="minPrice">Min price ₹</label><input id="minPrice" type="number" name="minPrice" min="0" step="100" value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>" placeholder="Any">
  <label for="maxPrice">Max price ₹</label><input id="maxPrice" type="number" name="maxPrice" min="0" step="100" value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>" placeholder="Any">
  <button type="submit">Apply price</button><a href="/listings#stays">Clear</a>
</form>

<div class="section-heading" id="stays">
  <div>
    <div class="section-kicker">The collection</div>
    <h2 class="section-title"><%= typeof search !== 'undefined' && search ? 'Places matching your search' : 'Places worth the detour' %></h2>
    <p class="section-subtitle">Find a place that feels like part of the adventure.</p>
  </div>
  <span class="section-count"><i class="fa-solid fa-compass me-1"></i> <%= allListings.length %> stays</span>
</div>

<div id="filters" aria-label="Stay categories">
  <div class="filter"><i class="fa-solid fa-fire"></i><p>Trending</p></div>
  <div class="filter"><i class="fa-solid fa-bed"></i><p>Slow stays</p></div>
  <div class="filter"><i class="fa-solid fa-city"></i><p>City breaks</p></div>
  <div class="filter"><i class="fa-solid fa-mountain-sun"></i><p>Mountains</p></div>
  <div class="filter"><i class="fa-solid fa-water"></i><p>By the water</p></div>
  <div class="filter"><i class="fa-solid fa-campground"></i><p>Outdoors</p></div>
  <div class="filter"><i class="fa-solid fa-house-chimney-window"></i><p>Hidden gems</p></div>
  <div class="tax-toggle">
    <div class="form-check form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
      <label class="form-check-label" for="flexSwitchCheckDefault">Show total with taxes</label>
    </div>
  </div>
</div>

<% if (allListings.length) { %>
  <div class="listing-grid">
    <% for (let listing of allListings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <article class="card listing-card">
          <div class="listing-image-wrap">
            <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&fit=crop&w=900&q=80' %>"
              class="card-img-top" alt="<%= listing.title %>" loading="lazy">
            <span class="listing-badge"><i class="fa-solid fa-leaf me-1"></i> Worth discovering</span>
            <span class="listing-heart" aria-hidden="true"><i class="fa-regular fa-heart"></i></span>
          </div>
          <div class="card-body">
            <div class="listing-title-row">
              <span class="listing-title"><%= listing.title %></span>
              <span class="listing-rating"><i class="fa-solid fa-star"></i> New</span>
            </div>
            <p class="card-text"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location || 'A place to discover' %><%= listing.country ? ', ' + listing.country : '' %></p>
            <div class="listing-price">₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "Price on request" %> <span>/ night</span><i class="tax-info"> · +18% GST</i></div>
          </div>
        </article>
      </a>
    <% } %>
  </div>
<% } else { %>
  <div class="empty-state">
    <i class="fa-solid fa-binoculars"></i>
    <h3>No stays found just yet</h3>
    <p class="text-muted mb-4">Try another destination or clear your search to see every place.</p>
    <a class="hero-btn hero-btn-primary" href="/listings">Explore all stays <i class="fa-solid fa-arrow-right"></i></a>
  </div>
<% } %>

<script>
  const taxSwitch = document.getElementById("flexSwitchCheckDefault");
  if (taxSwitch) {
    taxSwitch.addEventListener("change", () => {
      document.querySelectorAll(".tax-info").forEach(info => {
        info.style.display = taxSwitch.checked ? "inline" : "none";
      });
    });
  }
</script>