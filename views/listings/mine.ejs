<% layout("/layouts/boilerplate") %>

<section class="my-listings-page">
  <div class="my-listings-heading">
    <div>
      <div class="section-kicker">Your host space</div>
      <h1 class="section-title">My listings</h1>
      <p class="section-subtitle">All the stays you manage, together in one place.</p>
    </div>
    <a class="hero-btn hero-btn-primary" href="/listings/new"><i class="fa-solid fa-plus"></i> Add a stay</a>
  </div>

  <% if (listings.length) { %>
    <div class="my-listings-grid">
      <% listings.forEach((listing) => { %>
        <article class="my-listing-card <%= listing.isArchived ? 'is-archived' : '' %>">
          <a class="my-listing-photo" href="/listings/<%= listing._id %>" aria-label="View <%= listing.title %>">
            <img src="<%= listing.gallery?.[0]?.url || listing.image?.url || 'https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&fit=crop&w=900&q=80' %>" alt="<%= listing.title %>" loading="lazy">
          </a>
          <div class="my-listing-content">
            <div class="my-listing-title-row">
              <h2><%= listing.title %></h2>
              <span class="my-listing-status <%= listing.isArchived ? 'is-archived' : '' %>"><%= listing.isArchived ? 'Archived' : 'Active' %></span>
            </div>
            <p class="text-muted mb-1"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %><%= listing.country ? ', ' + listing.country : '' %></p>
            <p class="my-listing-price">₹ <%= Number(listing.price || 0).toLocaleString('en-IN') %> <span>/ night</span></p>
            <div class="my-listing-actions">
              <a class="btn my-listing-action-primary" href="/listings/<%= listing._id %>">View stay</a>
              <a class="btn my-listing-action-secondary" href="/listings/<%= listing._id %>/edit">Edit</a>
              <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Delete this listing? This cannot be undone.');">
                <button class="btn my-listing-action-danger" type="submit">Delete</button>
              </form>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state my-listings-empty">
      <i class="fa-solid fa-house-circle-check"></i>
      <h3>Your stays will appear here</h3>
      <p class="text-muted mb-4">Create your first listing to find it here whenever you need to edit or manage it.</p>
      <a class="hero-btn hero-btn-primary" href="/listings/new"><i class="fa-solid fa-plus"></i> Create a listing</a>
    </div>
  <% } %>
</section>
