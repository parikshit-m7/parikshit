<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3>Create a New Listing</h3>

    <form 
        method="POST" action="/listings" 
        novalidate 
        class="needs-validation" 
        enctype="multipart/form-data">

      <!-- Title -->
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>

        <input
          name="listing[title]"
          placeholder="Add a catchy title"
          type="text"
          class="form-control"
          required
        />

        <div class="valid-feedback">
          Title looks good!
        </div>
      </div>


      <!-- Description -->
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>

        <textarea
          name="listing[description]"
          class="form-control"
          required
        ></textarea>

        <div class="invalid-feedback">
          Please enter a short description.
        </div>
      </div>


      <!-- Image -->
      <div class="mb-3">
        <label for="image" class="form-label">Upload Listing Image</label>
        <input name="listing[image]" type="file" class="form-control" accept="image/png,image/jpeg,image/jpg" required />
      </div>

      <!-- Price + Country -->
      <div class="row">

        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>

          <input
            name="listing[price]"
            placeholder="1200"
            type="number"
            class="form-control"
            required
            min="0"
          />

          <div class="invalid-feedback">
            Price should be valid.
          </div>
        </div>

        <div class="mb-3 col-md-4">
          <label for="rooms" class="form-label">Rooms available</label>
          <input id="rooms" name="listing[rooms]" type="number" class="form-control" min="1" max="99" value="1" required>
          <div class="form-text">Guests can book up to this many rooms for the same dates.</div>
        </div>


        <div class="mb-3 col-md-4">
          <label for="country" class="form-label">Country</label>

          <input
            name="listing[country]"
            placeholder="India"
            type="text"
            class="form-control"
            required
          />

          <div class="invalid-feedback">
            Country name should be valid.
          </div>
        </div>

      </div>


      <!-- Location -->
      <div class="mb-3">
        <label for="location" class="form-label">Location</label>

        <input
          name="listing[location]"
          placeholder="Jaipur, Rajasthan"
          type="text"
          class="form-control"
          required
        />

        <div class="invalid-feedback">
          Location should be valid.
        </div>
      </div>

      <fieldset class="mb-3">
        <legend class="form-label">Stay categories</legend>
        <div class="form-text mb-2">Select the categories that describe your stay. Guests can use these to filter stays by destination.</div>
        <div class="d-flex flex-wrap gap-3">
          <label><input type="checkbox" name="listing[categories][]" value="slow-stays"> Slow stays</label>
          <label><input type="checkbox" name="listing[categories][]" value="city-breaks"> City breaks</label>
          <label><input type="checkbox" name="listing[categories][]" value="mountains"> Mountains</label>
          <label><input type="checkbox" name="listing[categories][]" value="by-water"> By the water</label>
          <label><input type="checkbox" name="listing[categories][]" value="outdoors"> Outdoors</label>
          <label><input type="checkbox" name="listing[categories][]" value="hidden-gems"> Hidden gems</label>
        </div>
      </fieldset>


      <!-- Button -->
      <button class="btn btn-dark add-btn mt-3">
        Add
      </button>

    </form>
  </div>
</div>
