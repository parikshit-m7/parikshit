<% layout("/layouts/boilerplate") %>
<script>
  const mapToken = <%- JSON.stringify(process.env.MAP_TOKEN || "") %>;
  const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="detail-header">
  <div>
    <div class="section-kicker">A closer look</div>
    <h1 class="mb-2"><%= listing.title %></h1>
    <div class="detail-location"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %><%= listing.country ? ', ' + listing.country : '' %></div>
  </div>
  <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
    <div class="detail-actions">
      <a class="btn btn-outline-dark" href="/listings/<%= listing._id %>/edit"><i class="fa-solid fa-pen me-1"></i>Edit stay</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Delete this listing? This cannot be undone.');">
        <button class="btn btn-dark" type="submit"><i class="fa-regular fa-trash-can me-1"></i>Delete</button>
      </form>
    </div>
  <% } %>
</div>

<div class="detail-gallery">
  <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&fit=crop&w=1400&q=80' %>"
    class="show-img" alt="<%= listing.title %>" fetchpriority="high">
</div>

<div class="detail-panel">
  <div class="row g-4">
    <div class="col-lg-8">
      <div class="detail-main-card">
        <div class="d-flex align-items-center gap-3">
          <span class="brand-mark"><i class="fa-solid fa-house"></i></span>
          <div><h5 class="mb-1 fw-bold">Hosted with care</h5><p class="text-muted mb-0">Shared by <strong><%= listing.owner ? listing.owner.username : 'Wanderlust host' %></strong></p></div>
        </div>
      </div>
      <div class="detail-main-card">
        <h4 class="fw-bold mb-3">The story of this stay</h4>
        <p class="text-muted mb-0" style="line-height:1.9;white-space:pre-line"><%= listing.description || 'A lovely place to slow down, explore, and make a few new memories.' %></p>
      </div>
      <div class="detail-main-card">
        <h4 class="fw-bold mb-3">Where you'll be</h4>
        <p class="text-muted"><i class="fa-solid fa-map-pin me-2"></i><%= listing.location %><%= listing.country ? ', ' + listing.country : '' %></p>
        <div id="map"></div>
        <p class="small text-muted mt-3 mb-0">Map pin is approximate and may depend on the location details provided by the host.</p>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="p-4" style="position:sticky;top:110px;border:1px solid var(--line);border-radius:22px;background:#fff;box-shadow:var(--shadow)">
        <div class="detail-price">₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : 'On request' %> <span>/ night</span></div>
        <div class="text-muted small mt-2"><i class="fa-solid fa-shield-heart me-1"></i> Your next story starts here.</div>
        <hr style="border-color:var(--line);margin:22px 0">
        <div class="d-flex gap-3 mb-3"><i class="fa-solid fa-location-dot mt-1" style="color:var(--green)"></i><div><strong>Destination</strong><div class="text-muted small"><%= listing.location %></div></div></div>
        <div class="d-flex gap-3 mb-3"><i class="fa-solid fa-earth-asia mt-1" style="color:var(--green)"></i><div><strong>Country</strong><div class="text-muted small"><%= listing.country %></div></div></div>
        <div class="d-flex gap-3"><i class="fa-solid fa-user-check mt-1" style="color:var(--green)"></i><div><strong>Local host</strong><div class="text-muted small"><%= listing.owner ? listing.owner.username : 'Wanderlust host' %></div></div></div>
        <% if (!currUser) { %>
          <a class="hero-btn hero-btn-primary w-100 mt-4" href="/login" style="text-align:center">Log in to review <i class="fa-solid fa-arrow-right"></i></a>
        <% } %>
      </div>
    </div>
  </div>

  <section class="detail-main-card">
    <div class="section-kicker">Community notes</div>
    <h3 class="section-title mb-4">Guest reviews <span class="text-muted fs-6">(<%= listing.reviews.length %>)</span></h3>
    <% if (currUser) { %>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation review-form mb-4">
        <h5 class="fw-bold mb-3">Leave a review</h5>
        <div class="mb-3">
          <label for="rating" class="form-label fw-semibold">Your rating</label>
          <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" /><label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" /><label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" /><label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" /><label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" /><label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>
        <div class="mb-3"><label for="comment" class="form-label fw-semibold">Your experience</label><textarea name="review[comment]" id="comment" rows="4" class="form-control" placeholder="What made this stay memorable?" required></textarea><div class="invalid-feedback">Please add a few words about your experience.</div></div>
        <button class="btn btn-dark" type="submit">Share your review <i class="fa-solid fa-arrow-right ms-1"></i></button>
      </form>
    <% } %>

    <% if (listing.reviews.length > 0) { %>
      <div class="row g-3">
        <% for (const review of listing.reviews) { %>
          <div class="col-md-6"><article class="review-card">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div><h6 class="fw-bold mb-1"><%= review.author ? review.author.username : 'Guest' %></h6><p class="small text-muted mb-2">Wanderlust guest</p></div>
              <span class="small"><i class="fa-solid fa-star" style="color:#e4a54e"></i> <%= review.rating %>/5</span>
            </div>
            <p class="mb-3" style="line-height:1.75"><%= review.comment %></p>
            <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
              <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-outline-dark" type="submit">Delete your review</button>
              </form>
            <% } %>
          </article></div>
        <% } %>
      </div>
    <% } else { %>
      <p class="text-muted">No reviews yet. If you've stayed here, be the first to share your experience.</p>
    <% } %>
  </section>
</div>

<script src="/js/map.js"></script>