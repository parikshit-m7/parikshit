<% layout("/layouts/boilerplate") %>
<section class="auth-shell">
  <div class="auth-card">
    <div class="brand-mark auth-brand-mark">✦</div>
    <p class="auth-eyebrow">PHONE VERIFIED</p>
    <h1 class="auth-title">Finish creating your account</h1>
    <p class="auth-subtitle">Your mobile number is verified. Choose a username and password to finish signup.</p>

    <form action="/complete-phone-signup" method="post" class="needs-validation" novalidate>
      <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <input name="username" id="username" type="text" class="form-control auth-input" autocomplete="username" maxlength="40" value="<%= username || '' %>" placeholder="Choose a username" required />
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input name="password" id="password" type="password" class="form-control auth-input" autocomplete="new-password" minlength="8" required />
        <div class="form-text auth-help">Use at least 8 characters.</div>
      </div>
      <button type="submit" class="auth-submit-btn">Create account</button>
    </form>
  </div>
</section>
