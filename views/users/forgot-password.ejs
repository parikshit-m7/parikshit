<% layout("/layouts/boilerplate") %>
<section class="row justify-content-center py-5">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="auth-recovery-card p-4 p-md-5">
      <div class="brand-mark mb-4"><i class="fa-solid fa-key"></i></div>
      <div class="section-kicker">Account recovery</div>
      <h1 class="section-title mb-3">Forgot your password?</h1>
      <form action="/forgot-password" method="POST">
        <div class="mb-4">
          <label for="phone" class="visually-hidden">Mobile number</label>
          <input id="phone" name="phone" type="tel" class="form-control auth-input" autocomplete="tel" inputmode="tel" value="<%= fieldValues?.phone || '' %>" placeholder="Mobile number" required maxlength="20">
          <%- include("../includes/field-error.ejs", { field: "phone" }) %>
        </div>
        <button class="hero-btn hero-btn-primary w-100 border-0" type="submit">Send OTP <i class="fa-solid fa-paper-plane"></i></button>
      </form>
    </div>
  </div>
</section>
