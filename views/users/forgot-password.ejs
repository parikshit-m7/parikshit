<% layout("/layouts/boilerplate") %>
<section class="row justify-content-center py-5">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="p-4 p-md-5" style="background:#fff;border:1px solid var(--line);border-radius:26px;box-shadow:var(--shadow)">
      <div class="brand-mark mb-4"><i class="fa-solid fa-key"></i></div>
      <div class="section-kicker">Account recovery</div>
      <h1 class="section-title mb-3">Forgot your password?</h1>
      <p class="text-muted mb-4" style="line-height:1.8">Enter your username or mobile number. We'll send a 6-digit OTP to the recovery email linked to your account.</p>
      <form action="/forgot-password" method="POST">
        <div class="mb-4">
          <label for="identifier" class="visually-hidden">Username or mobile number</label>
          <input id="identifier" name="identifier" type="text" class="form-control auth-input" autocomplete="username" value="<%= fieldValues?.identifier || '' %>" placeholder="Username or mobile number" required maxlength="254">
          <%- include("../includes/field-error.ejs", { field: "identifier" }) %>
        </div>
        <button class="hero-btn hero-btn-primary w-100 border-0" type="submit">Send OTP <i class="fa-solid fa-paper-plane"></i></button>
      </form>
    </div>
  </div>
</section>
