<% layout("/layouts/boilerplate") %>
<section class="row justify-content-center py-5">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="p-4 p-md-5" style="background:#fff;border:1px solid var(--line);border-radius:26px;box-shadow:var(--shadow)">
      <div class="brand-mark mb-4"><i class="fa-solid fa-key"></i></div>
      <div class="section-kicker">Account recovery</div>
      <h1 class="section-title mb-3">Forgot your password?</h1>
      <p class="text-muted mb-4" style="line-height:1.8">Enter the email address linked to your Wanderlust account. We'll send a 6-digit OTP to verify it's you.</p>
      <form action="/forgot-password" method="POST">
        <div class="mb-4">
          <label for="email" class="form-label fw-semibold">Email address</label>
          <input id="email" name="email" type="email" class="form-control" autocomplete="email" placeholder="you@gmail.com" required maxlength="254">
        </div>
        <button class="hero-btn hero-btn-primary w-100 border-0" type="submit">Send OTP <i class="fa-solid fa-paper-plane"></i></button>
      </form>
      <p class="text-center mt-4 mb-0 small"><a href="/login" style="color:var(--green)"><i class="fa-solid fa-arrow-left me-1"></i> Back to login</a></p>
    </div>
  </div>
</section>