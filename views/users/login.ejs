<% layout("/layouts/boilerplate") %>

<section class="auth-shell">
  <div class="auth-card">
    <div class="brand-mark auth-brand-mark">✦</div>
    <p class="auth-eyebrow">WELCOME BACK</p>
    <h1 class="auth-title">Log in to Wanderlust</h1>
    <p class="auth-subtitle">Pick up where your next trip begins.</p>

    <a href="/auth/google" class="google-signin-btn">
      <span class="google-mark" aria-hidden="true">G</span>
      <span>Continue with Google</span>
    </a>

    <div class="auth-divider"><span>or log in with your account</span></div>

    <form action="/login" method="post" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="identifier" class="form-label">Username, email, or mobile number</label>
        <input
          name="identifier"
          id="identifier"
          type="text"
          class="form-control auth-input"
          autocomplete="username"
          placeholder="you@gmail.com or +91 9876543210"
          required
        />
      </div>

      <div class="mb-2">
        <label for="password" class="form-label">Password</label>
        <input
          name="password"
          id="password"
          type="password"
          class="form-control auth-input"
          autocomplete="current-password"
          required
        />
      </div>

      <p class="text-end mb-4">
        <a class="forgot-password-link" href="/forgot-password">Forgot password?</a>
      </p>

      <button type="submit" class="auth-submit-btn">Log in</button>
    </form>

    <p class="auth-switch">New to Wanderlust? <a href="/signup">Create an account</a></p>
    <p class="auth-legal">By continuing, you agree to Wanderlust's <a href="/Terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
  </div>
</section>
