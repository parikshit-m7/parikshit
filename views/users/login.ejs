<% layout("/layouts/boilerplate") %>

<section class="auth-shell">
  <div class="auth-card">
    <div class="brand-mark auth-brand-mark">✦</div>
    <p class="auth-eyebrow">WELCOME BACK</p>
    <h1 class="auth-title">Log in to Wanderlust</h1>
    <p class="auth-subtitle">Pick up where your next trip begins.</p>

    <a href="/auth/google?intent=login" class="google-signin-btn">
      <span class="google-mark" aria-hidden="true">G</span>
      <span>Continue with Google</span>
    </a>

    <div class="auth-divider"><span>or log in with your account</span></div>

    <form action="/login" method="post" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="identifier" class="visually-hidden">Username or mobile number</label>
        <input
          name="identifier"
          id="identifier"
          type="text"
          class="form-control auth-input"
          autocomplete="username"
          value="<%= fieldValues?.identifier || '' %>"
          placeholder="Username or mobile number"
          required
        />
        <%- include("../includes/field-error.ejs", { field: "identifier" }) %>
      </div>

      <div class="mb-2">
        <label for="password" class="visually-hidden">Password</label>
        <input
          name="password"
          id="password"
          type="password"
          class="form-control auth-input"
          autocomplete="current-password"
          placeholder="Password"
          required
        />
        <%- include("../includes/field-error.ejs", { field: "password" }) %>
      </div>

      <p class="text-end mb-4">
        <a class="forgot-password-link" href="/forgot-password">Forgot password?</a>
      </p>

      <button type="submit" class="auth-submit-btn">Log in</button>
    </form>

    <p class="auth-switch">New to Wanderlust? <a href="/signup">Create an account</a></p>
  </div>
</section>
