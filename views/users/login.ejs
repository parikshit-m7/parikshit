<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-12 col-md-8 col-lg-5 mx-auto">Login</h1>
  <div class="col-12 col-md-8 col-lg-5 mx-auto">
    <form action="/login" method="post" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          name="username"
          id="username"
          type="text"
          class="form-control"
          required
        />
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          name="password"
          id="password"
          type="password"
          class="form-control"
          required
        />
      </div>
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><a href="/forgot-password">Forgot password?</a></div>\n      <button class="btn btn-success">Login</button>
    </form>
  </div>
</div>
     