<% layout("/layouts/boilerplate") %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
      <h1 class="text-center mb-4">Login</h1>

      <form action="/login" method="post" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="identifier" class="form-label">Username, email, or mobile number</label>
          <input
            name="identifier"
            id="identifier"
            type="text"
            class="form-control"
            autocomplete="username"
            placeholder="Username, you@gmail.com, or +91 9876543210"
            required
          />
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input
            name="password"
            id="password"
            type="password"
            class="form-control"
            autocomplete="current-password"
            required
          />
        </div>

        <p class="text-end mb-3">
          <a class="forgot-password-link" href="/forgot-password">Forgot password?</a>
        </p>

        <div class="text-center">
          <button type="submit" class="btn btn-success rounded-pill px-4">Login</button>
          <p class="mt-3 mb-0">New to Wanderlust? <a href="/signup">Create an account</a></p>
        </div>
      </form>
    </div>
  </div>
</div>
