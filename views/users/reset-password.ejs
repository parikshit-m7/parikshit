<% layout("/layouts/boilerplate") %>
<section class="row justify-content-center py-5">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="p-4 p-md-5" style="background:#fff;border:1px solid var(--line);border-radius:26px;box-shadow:var(--shadow)">
      <div class="brand-mark mb-4"><i class="fa-solid fa-shield-halved"></i></div>
      <div class="section-kicker">Make it yours again</div>
      <h1 class="section-title mb-3">Create a new password</h1>
      <p class="text-muted mb-4">Choose a strong password with at least 8 characters.</p>
      <form action="<%= typeof token !== 'undefined' && token ? '/reset-password/' + token : '/reset-password' %>" method="POST">
        <div class="mb-3">
          <label for="password" class="form-label fw-semibold">New password</label>
          <input id="password" name="password" type="password" class="form-control" autocomplete="new-password" minlength="8" required>
          <%- include("../includes/field-error.ejs", { field: "password" }) %>
        </div>
        <div class="mb-4">
          <label for="confirmPassword" class="form-label fw-semibold">Confirm new password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" autocomplete="new-password" minlength="8" required>
          <%- include("../includes/field-error.ejs", { field: "confirmPassword" }) %>
        </div>
        <button class="hero-btn hero-btn-primary w-100 border-0" type="submit">Update password <i class="fa-solid fa-lock"></i></button>
      </form>
    </div>
  </div>
</section>
