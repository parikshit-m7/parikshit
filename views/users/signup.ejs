<% layout("/layouts/boilerplate") %>

<section class="auth-shell">
  <div class="auth-card">
    <div class="brand-mark auth-brand-mark">✦</div>
    <p class="auth-eyebrow">START YOUR JOURNEY</p>
    <h1 class="auth-title">Create your Wanderlust account</h1>
    <p class="auth-subtitle">Choose Google, or create an account with a username or mobile number.</p>

    <a href="/auth/google?intent=signup" class="google-signin-btn">
      <span class="google-mark" aria-hidden="true">G</span>
      <span>Continue with Google</span>
    </a>

    <div class="auth-divider"><span>or create an account</span></div>

    <form action="/signup" method="post" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username <span class="auth-optional">optional if you add a mobile number</span></label>
        <input name="username" id="username" type="text" class="form-control auth-input" autocomplete="nickname" maxlength="40" placeholder="Choose a username" />
      </div>

      <div class="mb-3">
        <label for="phone" class="form-label">Mobile number <span class="auth-optional">optional if you add a username</span></label>
        <input name="phone" id="phone" type="tel" class="form-control auth-input" autocomplete="tel" inputmode="tel" placeholder="+91 9876543210" />
        <div class="form-text auth-help">Enter at least a username or mobile number. Either one works for future logins.</div>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input name="password" id="password" type="password" class="form-control auth-input" autocomplete="new-password" minlength="8" required />
        <div class="form-text auth-help">Use at least 8 characters.</div>
      </div>

      <button type="submit" class="auth-submit-btn">Create account</button>
    </form>

    <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
    <p class="auth-legal">By continuing, you agree to Wanderlust's <a href="/Terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
  </div>
</section>
