<% layout("/layouts/boilerplate") %>

<section class="row justify-content-center py-4">
  <div class="col-12 col-md-8 col-lg-5">
    <h1 class="text-center mb-4">Sign up for Wanderlust</h1>
    <form action="/signup" method="post" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username <span class="text-muted">(optional)</span></label>
        <input
          name="username"
          id="username"
          type="text"
          class="form-control"
          autocomplete="nickname"
          maxlength="40"
          placeholder="Choose a username"
        />
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email <span class="text-muted">(optional if you enter a phone number)</span></label>
        <input
          name="email"
          id="email"
          type="email"
          class="form-control"
          autocomplete="email"
          maxlength="254"
          placeholder="you@gmail.com"
        />
      </div>

      <div class="mb-3">
        <label for="phone" class="form-label">Mobile number <span class="text-muted">(optional if you enter an email)</span></label>
        <input
          name="phone"
          id="phone"
          type="tel"
          class="form-control"
          autocomplete="tel"
          inputmode="tel"
          placeholder="+91 9876543210"
        />
        <div class="form-text">Enter at least an email address or a mobile number. You can log in with either one and your password.</div>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          name="password"
          id="password"
          type="password"
          class="form-control"
          autocomplete="new-password"
          minlength="8"
          required
        />
        <div class="form-text">Use at least 8 characters.</div>
      </div>
      <button class="btn btn-success">Create account</button>
      <p class="mt-3 mb-0">Already have an account? <a href="/login">Log in</a></p>
    </form>
  </div>
</section>
