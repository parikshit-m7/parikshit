<% layout("/layouts/boilerplate") %>

<section class="auth-shell">
  <div class="auth-card">
    <div class="brand-mark auth-brand-mark">✦</div>
    <p class="auth-eyebrow">START YOUR JOURNEY</p>
    <h1 class="auth-title">Create your Wanderlust account</h1>
    <a id="google-signup" href="/auth/google?intent=signup" class="google-signin-btn">
      <span class="google-mark" aria-hidden="true">G</span>
      <span>Continue with Google</span>
    </a>

    <div class="auth-divider"><span>or create an account</span></div>

    <form action="/signup" method="post" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="phone" class="visually-hidden">Mobile number</label>
        <input name="phone" id="phone" type="tel" class="form-control auth-input" autocomplete="tel" inputmode="tel" value="<%= fieldValues?.phone || '' %>" placeholder="Mobile number" required />
        <%- include("../includes/field-error.ejs", { field: "phone" }) %>
      </div>

      <button type="submit" class="auth-submit-btn">Send verification code</button>
    </form>

    <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
  </div>
</section>
