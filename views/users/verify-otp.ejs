<% layout("/layouts/boilerplate") %>
<section class="row justify-content-center py-5">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="p-4 p-md-5" style="background:#fff;border:1px solid var(--line);border-radius:26px;box-shadow:var(--shadow)">
      <div class="brand-mark mb-4"><i class="fa-solid fa-envelope"></i></div>
      <div class="section-kicker">Email verification</div>
      <h1 class="section-title mb-3">Enter your OTP</h1>
      <p class="text-muted mb-4" style="line-height:1.8">Enter the 6-digit code sent to <strong><%= email %></strong>. It expires in 10 minutes. Check your Spam folder if it doesn't arrive.</p>
      <form action="/verify-otp" method="POST">
        <div class="mb-4">
          <label for="otp" class="visually-hidden">6-digit OTP</label>
          <input id="otp" name="otp" type="text" class="form-control auth-input text-center" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="6-digit OTP" required>
          <%- include("../includes/field-error.ejs", { field: "otp" }) %>
        </div>
        <button class="hero-btn hero-btn-primary w-100 border-0" type="submit">Verify OTP</button>
      </form>
      <form action="/forgot-password" method="POST" class="auth-resend-form">
        <input type="hidden" name="identifier" value="<%= email %>">
        <button type="submit" class="auth-resend-btn">Request a new OTP</button>
      </form>
    </div>
  </div>
</section>
