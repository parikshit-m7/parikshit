<% layout("/layouts/boilerplate") %>
<section class="auth-shell">
  <div class="auth-card">
    <div class="brand-mark auth-brand-mark">✦</div>
    <p class="auth-eyebrow">PHONE VERIFICATION</p>
    <h1 class="auth-title">Verify your mobile number</h1>
    <p class="auth-subtitle">Enter the 6-digit code sent to <strong><%= phone.slice(0, -4).replace(/\d/g, "•") %><%= phone.slice(-4) %></strong>.</p>

    <form action="/verify-phone" method="post">
      <div class="mb-3">
        <label for="otp" class="form-label">6-digit code</label>
        <input name="otp" id="otp" type="text" class="form-control auth-input text-center" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="123456" required autofocus />
      </div>
      <button type="submit" class="auth-submit-btn">Verify number</button>
    </form>

    <form action="/verify-phone/resend" method="post" class="mt-3">
      <button type="submit" class="btn btn-link w-100">Send a new code</button>
    </form>
  </div>
</section>
